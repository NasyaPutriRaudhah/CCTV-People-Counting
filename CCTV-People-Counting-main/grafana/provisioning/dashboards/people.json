{
  "annotations": { "list": [] },
  "description": "CCTV People Counting Live Dashboard",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [

    {
      "id": 1,
      "title": "ROI Count",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 20 }
          ]},
          "unit": "short", "decimals": 0, "displayName": "People in Zone"
        }, "overrides": []
      },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "cctv-postgres" },
        "rawSql": "SELECT time, roi_count AS value FROM cctv.realtime_metrics ORDER BY time DESC LIMIT 1",
        "format": "table", "refId": "A"
      }]
    },

    {
      "id": 2,
      "title": "Line Crossings",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Entries" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "Exits" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "cctv-postgres" },
        "rawSql": "SELECT NOW() AS time, total_entries AS \"Entries\", total_exits AS \"Exits\" FROM cctv.session ORDER BY id DESC LIMIT 1",
        "format": "table", "refId": "A"
      }]
    },

    {
      "id": 3,
      "title": "Total Occupancy",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "area", "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 30 },
            { "color": "red", "value": 50 }
          ]},
          "unit": "short", "decimals": 0, "displayName": "Current Occupancy"
        }, "overrides": []
      },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "cctv-postgres" },
        "rawSql": "SELECT time, (roi_count + occupancy) AS value FROM cctv.realtime_metrics ORDER BY time DESC LIMIT 1",
        "format": "table", "refId": "A"
      }]
    },

    {
      "id": 4,
      "title": "Frame Per Second",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none",
        "justifyMode": "center", "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "green", "value": 25 }
          ]},
          "unit": "short", "decimals": 1, "displayName": "FPS"
        }, "overrides": []
      },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "cctv-postgres" },
        "rawSql": "SELECT time, fps AS value FROM cctv.realtime_metrics ORDER BY time DESC LIMIT 1",
        "format": "table", "refId": "A"
      }]
    },

    {
      "id": 5,
      "title": "People Count — Last 24 Hours (per hour)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth",
            "lineWidth": 2, "fillOpacity": 15, "pointSize": 5,
            "showPoints": "auto"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ROI Count" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "Crossing" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "Total Occupancy" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "cctv-postgres" },
        "rawSql": "SELECT date_trunc('hour', time) AS \"time\", ROUND(AVG(roi_count)) AS \"ROI Count\", ROUND(AVG(occupancy)) AS \"Crossing\", ROUND(AVG(roi_count + occupancy)) AS \"Total Occupancy\" FROM cctv.realtime_metrics WHERE time >= NOW() - INTERVAL '24 hours' GROUP BY 1 ORDER BY 1",
        "format": "time_series", "refId": "A"
      }]
    }

  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["cctv", "people-counting"],
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "title": "People Counting",
  "uid": "people",
  "version": 1
}
